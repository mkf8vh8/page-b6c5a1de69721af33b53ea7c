lan li{padding:12px 0 12px 20px;position:relative;font-size:15px;border-bottom:1px solid var(--line)}\n.plan li::before{content:\"\";position:absolute;left:0;top:21px;width:7px;height:7px;border-radius:50%;background:var(--amber)}\n.plan-note{margin:26px 0 0;font-size:14px;color:var(--muted)}\n.plan-note code{background:#eef2f6;border-radius:6px;padding:1px 6px;font-size:13px}\n\n/* 客户端 */\n.clients{display:grid;grid-template-columns:repeat(2,1fr);gap:26px}\n.client{background:#fff;border-radius:var(--radius);box-shadow:0 14px 36px rgba(12,39,64,.08);padding:28px 26px;display:flex;gap:20px;align-items:flex-start}\n.client .mark{flex:none;width:46px;height:46px;border-radius:14px;background:linear-gradient(160deg,var(--navy),#17436b);color:var(--amber);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:15px;letter-spacing:.04em}\n.client p{margin:6px 0 0;font-size:15px;color:var(--muted)}\n.client .hint{font-size:13px;color:#8b98a6;margin-top:10px}\n\n/* FAQ 分组 */\n.faq-groups{display:grid;gap:30px}\n.faq-group{background:#fff;border-radius:var(--radius);box-shadow:0 14px 36px rgba(12,39,64,.08);padding:30px 30px 10px}\n.faq-group h3{font-size:15px;letter-spacing:.14em;text-transform:uppercase;color:var(--amber);margin:0 0 16px}\n.faq-item{border-top:1px solid var(--line);padding:18px 0}\n.faq-item:first-of-type{border-top:0}\n.faq-item h4{margin:0 0 6px;font-size:17px;font-weight:700}\n.faq-item p{margin:0;color:var(--muted);font-size:15px}\n\n/* 收尾 */\n.tail{background:linear-gradient(180deg,var(--navy) 0%,var(--navy-deep) 100%);color:#dbe6ef;padding:70px 0 76px}\n.tail h2{color:#fff;max-width:18em}\n.tail p{max-width:42em;color:#a9bccd;margin:0 0 14px}\n.tail a.jump{display:inline-block;margin-top:18px;padding:12px 22px;border:1px solid rgba(232,163,61,.55);border-radius:999px;color:var(--amber);text-decoration:none;font-size:15px;font-weight:600}\n.tail a.jump:hover,.tail a.jump:focus-visible{background:rgba(232,163,61,.14)}\nfooter{background:var(--navy-deep);color:#7e93a6;font-size:13px;padding:26px 0 34px;border-top:1px solid rgba(255,255,255,.07)}\nfooter .wrap{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}\n\n/* 响应式 */\n@media (max-width:900px){.hero-cols{grid-template-columns:1fr;gap:34px}\n  .steps{grid-template-columns:1fr}\n  .plans{grid-template-columns:1fr;align-items:stretch}\n  .plan:nth-child(n){padding:30px 26px}\n  .clients{grid-template-columns:1fr}}\n@media (max-width:560px){\n  .hero{padding:52px 0 62px}\n  section{padding:56px 0}\n  .wrap{padding:0 18px}\n  .brand-line{font-size:13px;letter-spacing:.16em}\n  .anchors a{font-size:14px;padding:13px 12px}\n}\n</style><main>\n\n  <header class=\"hero\">\n    <div class=\"wrap\">\n      <div class=\"brand-line\">\n        <span>LEOX</span>\n        <span>乐牛 · 订阅与配置说明</span>\n      </div>\n\n      <h1>乐牛(LEOX) · 乐牛 LEOX：一份把事情<em>说明白</em>的订阅方案</h1>\n\n      <div class=\"hero-cols\">\n        <div class=\"body-text\">\n          <p class=\"lede\">我们不打算用形容词说服你。<strong>先看条款，再看价格，最后决定要不要用。</strong></p>\n          <p>订阅类服务最容易含糊三件事：你到底买了什么、设备够不够用、出问题找谁。这一页把这三件事拆开写。</p>\n          <p>三档套餐按流量与同时在线设备数区分，年付一次性结清。客户端部分给出通用的配置路径，具体版本可能随系统更新变化，请以下发说明为准。</p>\n          <p>如果读完还有疑问，页面底部的常见问题按主题分了组：套餐与计费、设备与配置、使用与支持。</p>\n        </div>\n\n        <nav class=\"anchors\" aria-label=\"页面内锚点\">\n          <p>跳到</p>\n          <ul>\n            <li><a href=\"#how\">怎么开始使用 <small>三步</small></a></li>\n            <li><a href=\"#plans\">套餐与价格 <small>三档</small></a></li>\n            <li><a href=\"#clients\">客户端配置 <small>四端</small></a></li>\n            <li><a href=\"#faq\">常见问题 <small>分组</small></a></li>\n          </ul>\n        </nav>\n      </div>\n    </div>\n  </header>\n\n  <section id=\"how\">\n    <div class=\"wrap\">\n      <p class=\"kicker\">使用说明</p>\n      <h2>从下单到能用，就这三步</h2>\n      <p class=\"section-intro\">不需要技术背景。每一步做完再做下一步，中间卡住就翻到常见问题对照着看。</p>\n\n      <div class=\"steps\">\n        <article class=\"step\">\n          <div class=\"num\">01</div>\n          <h3>挑一档套餐</h3>\n          <p>先估自己每月的流量和同时在线设备数。一个人两台设备，基础版通常够；家里多台加流媒体，看旗舰版。</p>\n        </article>\n        <article class=\"step\">\n          <div class=\"num\">02</div>\n          <h3>拿到配置信息</h3>\n          <p>订阅完成后你会收到与套餐对应的配置说明。请妥善保管，不要转发给套餐之外的设备使用。</p>\n        </article>\n        <article class=\"step\">\n          <div class=\"num\">03</div>\n          <h3>在客户端里填入</h3>\n          <p>选择你设备上的客户端，按说明填入配置。完成后先测试一次连接，再逐个添加其他设备。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <p class=\"kicker\">套餐</p>\n      <h2>三档阶梯，按需往上走</h2>\n      <p class=\"section-intro\">差别主要在流量额度、同时在线设备数与支持优先级。月付与年付都有，年付为一次性结算。</p>\n\n      <div class=\"plans\">\n        <article class=\"plan\">\n          <p class=\"plan-tag\">第一级</p>\n          <h3>基础版</h3>\n          <p class=\"price\">¥15<small>/月</small></p>\n          <p class=\"annual\">按年付 ¥150/年</p>\n          <ul>\n            <li>每月 100GB 流量额度</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>解锁基础流媒体</li>\n            <li>普通线路节点池</li>\n          </ul>\n        </article>\n\n        <article class=\"plan\">\n          <p class=\"plan-tag\">第二级 · 常用选择</p>\n          <h3>旗舰版</h3>\n          <p class=\"price\">¥35<small>/月</small></p>\n          <p class=\"annual\">按年付 ¥350/年</p>\n          <ul>\n            <li>每月 300GB 流量额度</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7×24 优先工单支持</li>\n          </ul>\n        </article>\n\n        <article class=\"plan\">\n          <p class=\"plan-tag\">第三级</p>\n          <h3>团队版</h3>\n          <p class=\"price\">¥85<small>/月</small></p>\n          <p class=\"annual\">按年付 ¥850/年</p>\n          <ul>\n            <li>每月 1000GB 流量额度</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n        </article>\n      </div>\n\n      <p class=\"plan-note\">价格与权益以上表为准。年付为按年一次性结算，页面不提供自动续费设置；如需变更档位，请通过工单说明当前套餐与目标套餐。</p>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <p class=\"kicker\">客户端</p>\n      <h2>四个常见平台，各自怎么配</h2>\n      <p class=\"section-intro\">下面的路径是通用描述。不同客户端版本菜单名称可能略有差别，按下发说明里的字段对应填入即可。</p>\n\n      <div class=\"clients\">\n        <article class=\"client\">\n          <div class=\"mark\">iOS</div>\n          <div>\n            <h3>iPhone / iPad</h3>\n            <p>在 App Store 安装配置类客户端，导入订阅下发的配置信息，开启连接后在系统状态栏确认已生效。</p>\n            <p class=\"hint\">同一账号的在线设备数计入套餐上限，切换设备前先断开旧设备。</p>\n          </div>\n        </article>\n\n        <article class=\"client\">\n          <div class=\"mark\">AND</div>\n          <div>\n            <h3>Android 手机与平板</h3>\n            <p>安装客户端后手动添加配置，或按说明导入。首次连接允许系统的网络权限请求。</p>\n            <p class=\"hint\">部分机型有省电策略，可能中断后台连接，可在系统设置中放行该应用。</p>\n          </div>\n        </article>\n\n        <article class=\"client\">\n          <div class=\"mark\">MAC</div>\n          <div>\n            <h3>macOS 桌面</h3>\n            <p>安装对应客户端，将配置填入后选择节点并连接。建议先在一台设备上验证可用，再复制到其他设备。</p>\n            <p class=\"hint\">系统升级后若提示权限变更，按提示重新授权即可。</p>\n          </div>\n        </article>\n\n        <article class=\"client\">\n          <div class=\"mark\">WIN</div>\n          <div>\n            <h3>Windows 桌面</h3>\n            <p>安装客户端后导入配置，检查是否已选择正确节点，再测试一次连接状态与流量统计是否正常。</p>\n            <p class=\"hint\">如遇端口占用，关闭其他同类客户端后重试。</p>\n          </div>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <p class=\"kicker\">常见问题</p>\n      <h2>按主题分组，先看你在哪一类</h2>\n      <p class=\"section-intro\">问题按三类归拢：买之前想知道的、装的时候卡住的、用起来要处理的。</p>\n\n      <div class=\"faq-groups\">\n\n        <article class=\"faq-group\">\n          <h3>套餐与计费</h3>\n\n          <div class=\"faq-item\">\n            <h4>三档套餐最核心的区别是什么？</h4>\n            <p>两件事：每月流量额度，以及同时在线设备数。基础版 100GB / 3 台，旗舰版 300GB / 5 台，团队版 1000GB / 20 台。其余权益是随档位递增的附加项。</p>\n          </div>\n\n          <div class=\"faq-item\">\n            <h4>年付和月付差多少？</h4>\n            <p>基础版 ¥15/月、¥150/年；旗舰版 ¥35/月、¥350/年；团队版 ¥85/月、¥850/年。年付按年一次性结算，不是每月扣款。</p>\n          </div>\n\n          <div class=\"faq-item\">\n            <h4>流量用完了会怎样？</h4>\n            <p>流量额度按自然月计算。额度用尽后当月剩余时间将无法继续使用，可升级档位或等待下月重置。具体处理方式以下发说明中的条款为准。</p>\n          </div>\n\n          <div class=\"faq-item\">\n            <h4>可以中途换档吗？</h4>\n            <p>可以提出，但差价如何计算取决于当前计费周期与已用额度。请通过工单说明当前套餐、目标套餐与剩余周期，由支持人员确认后再操作。</p>\n          </div>\n        </article>\n\n        <article class=\"faq-group\">\n          <h3>设备与配置</h3>\n\n          <div class=\"faq-item\">\n            <h4>同时在线设备数怎么算？</h4>\n            <p>按同一时间处于连接状态的设备数量计算。关掉一台再接另一台，不额外占用名额；常驻后台的设备也会计入。</p>\n          </div>\n\n          <div class=\"faq-item\">\n            <h4>配置信息可以分享给朋友吗？</h4>\n            <p>不建议。配置信息与套餐绑定，分享会导致在线设备数超限，进而影响你自己的使用。需要多人使用，可以看团队版。</p>\n          </div>\n\n          <div class=\"faq-item\">\n            <h4>导入配置失败怎么办？</h4>\n            <p>先确认客户端版本是否过旧，再核对配置字段有无缺漏。若仍失败，请在工单中附上客户端名称与报错原文，不用附截图以外的隐私信息。</p>\n          </div>\n        </article>\n\n        <article class=\"faq-group\">\n          <h3>使用与支持</h3>\n\n          <div class=\"faq-item\">\n            <h4>连接后速度不理想，怎么排查？</h4>\n            <p>按顺序排查：更换节点试试、确认没有其他设备占用名额、检查本地网络是否稳定。三件事都正常仍不理想，再提交工单描述时间段与节点名称。</p>\n          </div>\n\n          <div class=\"faq-item\">\n            <h4>不同档位的支持响应有区别吗？</h4>\n            <p>旗舰版为 7×24 优先工单支持，团队版配有专属客户经理。基础版按常规工单顺序处理。响应时间以实际工单回复为准。</p>\n          </div>\n\n          <div class=\"faq-item\">\n            <h4>换了新手机，旧设备要做什么？</h4>\n            <p>在旧设备上断开并移除配置，再在新设备上填入。这样不会因为设备数超限而连接失败。</p>\n          </div>\n        </article>\n\n      </div>\n    </div>\n  </section>\n\n  <section class=\"tail\">\n    <div class=\"wrap\">\n      <h2>看到这里，剩下的就是选择</h2>\n      <p>如果你只想知道该买哪档：一个人两台设备，基础版；家里多设备并看流媒体，旗舰版；多人共用或需要定制路由，团队版。</p>\n      <p>如果还有页面没覆盖的情况，写清楚你的档位、设备与现象，通过工单提交，比描述感受更容易被解决。</p>\n      <a class=\"jump\" href=\"#plans\">回到套餐对照</a>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <span>乐牛 LEOX · 订阅与配置说明</span>\n    <span>套餐价格与权益以本页为准；客户端路径随版本变化，请以下发说明为准。</span>\n  </div>\n</footer>",
